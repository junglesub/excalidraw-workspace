# Private Excalidraw Workspace Environment Configuration

# Persistent data directory (Path where SQLite DB, attachments, and thumbnails are stored)
DATA_DIR=./data

# Initial Admin Account (Auto-bootstrapped on first server startup if no admin exists)
ADMIN_USERNAME=admin
# Development: blank uses admin1234!. Docker/production: set a unique password
# of at least 8 characters. The development default is rejected in production.
ADMIN_PASSWORD=

# Server Port
PORT=3000
